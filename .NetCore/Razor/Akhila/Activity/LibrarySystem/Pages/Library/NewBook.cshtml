@page
@model LibrarySystem.Pages.Library.NewBookModel
@{
    ViewData["title"] = "New Book";
}
<form method="post">
    <label>Title:</label>
    <input type="text" asp-for="Newbook.Title" required/>
    <span asp-validation-for="Newbook.Title" class="text-danger"></span>

    <label>Author:</label>
    <input type="text" asp-for="Newbook.Author" required />
    <span asp-validation-for="Newbook.Author" class="text-danger"></span>

    <label>Quantity:</label>
    <input type="text" asp-for="Newbook.Quantity" required />
    <span asp-validation-for="Newbook.Quantity" class="text-danger"></span>

    <button class="btn btn-primary" type="submit">Submit</button>
    <a asp-page="./AdminPage"class="btn btn-primary" >Back</a>
</form>
