@page
@model LibrarySystem.Pages.Library.AdminPageModel
@{
}
<h2>Welcome </h2>
<a asp-page="./NewBook" class="btn btn-primary">Add New Book</a>
<table class="table">
    <thead class="thead-dark">
        <tr>
            <th>Book Id</th>
            <th>Title</th>
            <th>Author</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model.GetBooks)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Quantity</td>
                <td>
                    <form method="post" asp-page- asp-page-handler="Delete" asp-route-id="@book.Id"
                    onsubmit="return confirm('Are you sure do you want to delete this book?')">
                        <button class="btn btn-primary" type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }

    </tbody>

</table>