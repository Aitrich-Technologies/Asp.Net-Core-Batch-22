@page "{id:int}"
@model Activity_Razor.Pages.StudentPages.DeleteModel
@{
  
}
<h2>Delete Student</h2>

<h3>Are you sure you want to delete this Student?</h3>

<div>
    <h4>Student Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.student.Name</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.student.Address</dd>

        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Model.student.Course</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="student.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
