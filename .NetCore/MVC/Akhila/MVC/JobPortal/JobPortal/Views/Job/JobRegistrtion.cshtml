@model JobPortal.Models.Job
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<h2>Add Job</h2>

<form asp-action="JobRegistrtion" method="post">
    <div class="form-group">
        <label>Title</label>
        <input asp-for="Title" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Description</label>
        <input asp-for="Description" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Location</label>
        <input asp-for="Location" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Salary</label>
        <input asp-for="Salary" class="form-control" type="number" required />
    </div>
    <button type="submit" class="btn btn-primary">Register Job</button>
</form>
