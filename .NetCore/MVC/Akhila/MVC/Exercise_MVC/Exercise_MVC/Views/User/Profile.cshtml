@{
}
@model Exercise_MVC.Models.User
<h1>@Model.First_Name @Model.Last_Name</h1>
<form asp-action="Profile" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-md-6">
            <label>About Me</label>
            <input asp-for="Aboutme" class="form-control" required />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <label>Education</label>
            <input asp-for="Education" class="form-control" required />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <label>Skills</label>
            <input asp-for="Skills" class="form-control" required />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <label>Experience</label>
            <input asp-for="Experience" class="form-control" required />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
           <button type="submit" class="btn btn-primary">Update</button>
        </div>
    </div>
</form>
